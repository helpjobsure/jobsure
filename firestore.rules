rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == "helpjobsure@gmail.com");
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == "helpjobsure@gmail.com");
      allow delete: if request.auth != null && request.auth.token.email == "helpjobsure@gmail.com";
    }

    match /students/{doc} {
      allow list: if request.auth != null && request.auth.token.email == "helpjobsure@gmail.com";
    }

    match /enquiries/{doc} {
      allow create: if true;
      allow read, delete: if request.auth != null && request.auth.token.email == "helpjobsure@gmail.com";
    }
  }
}
