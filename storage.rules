rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /students/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if request.auth != null && request.auth.token.email == "helpjobsure@gmail.com";
    }

    match /public/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && request.auth.token.email == "helpjobsure@gmail.com";
    }
  }
}
